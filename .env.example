# GEMINI-API Configuration Template
# Copy this file to .env and configure as needed

# Chrome DevTools Protocol URL (Default: http://127.0.0.1:9222)
CDP_URL=http://127.0.0.1:9222

# Gemini Web App Base URL
GEMINI_URL=https://gemini.google.com/app

# Response Generation Timeout (seconds)
DEFAULT_TIMEOUT_SECONDS=180

# Page Load Timeout (milliseconds)
PAGE_LOAD_TIMEOUT_MS=30000

# CLI Backend API Base URL
API_URL=http://127.0.0.1:8000
